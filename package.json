{
	"name": "kwartrack-workspace",
	"version": "1.0.3",
	"description": "A calm, self-hostable personal finance tracker built with React and Supabase.",
	"private": true,
	"license": "MIT",
	"homepage": "https://kwartrack.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/jcaburnay/kwartrack.git"
	},
	"engines": {
		"node": ">=24 <25",
		"pnpm": "10.34.5"
	},
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"bootstrap": "node scripts/setup.mjs",
		"release:check": "node scripts/check-release-version.mjs",
		"dev": "pnpm --filter @kwartrack/web dev",
		"build": "pnpm --filter @kwartrack/web build",
		"preview": "pnpm --filter @kwartrack/web preview",
		"test": "pnpm --filter @kwartrack/web test",
		"test:watch": "pnpm --filter @kwartrack/web test:watch",
		"api:dev": "pnpm --filter @kwartrack/api dev",
		"api:build": "pnpm --filter @kwartrack/api build",
		"api:start": "pnpm --filter @kwartrack/api start",
		"api:test": "pnpm --filter @kwartrack/api test",
		"api:test:integration": "pnpm --filter @kwartrack/api test:integration",
		"api:db:generate": "pnpm --filter @kwartrack/api db:generate",
		"api:db:migrate": "pnpm --filter @kwartrack/api db:migrate",
		"api:db:seed": "pnpm --filter @kwartrack/api db:seed",
		"local:setup": "APP_ENV=local node scripts/local/backend.mjs",
		"local:infra:setup": "APP_ENV=local node scripts/local/infra/setup.mjs",
		"local:infra:terraform": "APP_ENV=local node scripts/local/infra/terraform.mjs",
		"local:api:up": "APP_ENV=local node scripts/local/infra/api.mjs up",
		"local:smoke": "APP_ENV=local node scripts/local/infra/smoke.mjs",
		"local:smoke:balancing": "APP_ENV=local node scripts/local/infra/two-target-smoke.mjs",
		"local:test": "node --test scripts/local/infra/*.test.mjs",
		"local:auth:probe": "APP_ENV=local node scripts/local/auth/compatibility.mjs",
		"local:auth:setup": "APP_ENV=local node scripts/local/auth/setup.mjs",
		"local:auth:smoke": "APP_ENV=local node scripts/local/auth/smoke.mjs",
		"local:auth:restart-smoke": "APP_ENV=local node scripts/local/auth/restart-smoke.mjs",
		"local:auth:test": "node --test scripts/local/auth/*.test.mjs",
		"local:auth:reset": "APP_ENV=local node scripts/local/auth/reset.mjs",
		"local:status": "APP_ENV=local node scripts/local/infra/lifecycle.mjs status",
		"local:stop": "APP_ENV=local node scripts/local/infra/lifecycle.mjs stop",
		"local:reset": "APP_ENV=local node scripts/local/infra/lifecycle.mjs reset",
		"local:tools:terraform": "APP_ENV=local node scripts/local/infra/install-terraform.mjs",
		"mcp:build": "pnpm --filter @kwartrack/mcp build",
		"mcp:dev": "pnpm --filter @kwartrack/mcp dev",
		"mcp:test": "pnpm --filter @kwartrack/mcp test",
		"mcp:worker:build": "pnpm --filter @kwartrack/mcp worker:build",
		"mcp:worker:dev": "pnpm --filter @kwartrack/mcp worker:dev",
		"check": "biome check --write .",
		"ci": "biome ci .",
		"supabase:start": "supabase start",
		"supabase:reset": "supabase db reset --local",
		"supabase:stop": "supabase stop",
		"supabase:status": "supabase status",
		"types:gen": "supabase gen types typescript --local | grep -vE '^(Initialising|<claude-code-hint)' > apps/web/src/types/supabase.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"supabase": "2.116.0"
	}
}
